      "html": "<div class=\"ds-atlas-summary\"><p class=\"ds-atlas-person\"><strong class=\"ds-atlas-name\">Riley</strong><span class=\"ds-atlas-count\">5 countries · 3 territories</span></p><p class=\"ds-atlas-person\"><strong class=\"ds-atlas-name\">Morgan</strong><span class=\"ds-atlas-count\">5 countries · 1 territory</span></p><div class=\"ds-atlas-combined\"><p class=\"ds-atlas-person\"><strong class=\"ds-atlas-name\">Both visited</strong><span class=\"ds-atlas-count\">2 countries</span></p><p class=\"ds-atlas-person\"><strong class=\"ds-atlas-name\">Combined atlas</strong><span class=\"ds-atlas-count\">8 countries · 4 territories</span></p></div></div>",

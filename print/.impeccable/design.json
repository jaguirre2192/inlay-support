  "narrative": {
    "northStar": "A private gallery of travel memories",
    "overview": "The connected print studio extends Inlay’s approved print collection into a quiet working surface. Warm paper, deep green ink, fine Italiana lettering and authentic illustrated geography carry the existing identity; Instrument Serif gives captions and dedications an intimate print voice. Flat controls and thin rules keep the artwork prominent while making personalization easy to scan.\n\nThis record describes the completed implementation under /print/. Its visual authority is the approved private Inlay Print Collection design system, reconciled with studio.css and renderer.js. The separate support and invitation identity remains governed by the repository-root DESIGN.md. Page mode, first-viewport composition, task states and acceptance remain in the connected print surface brief; this document records the reusable visual rules found in the finished source.",
    "keyCharacteristics": [
      "Continuous warm paper and green ink connect the editor to the proof.",
      "Italiana display lettering, Instrument Serif captions and Instrument Sans controls have distinct roles.",
      "Nearly square controls, authored SVG disclosures, thin rules and aligned gutters provide quiet structure.",
      "Physical depth belongs to frames, photograph mounts and flag mounts; form surfaces stay flat.",
      "Complete artwork remains visible, with a separate contained inspection view for detail."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Keep the approved paper ground continuous between the proof and its surrounding editor; use deep green ink for the primary reading and action hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Reserve Italiana for large headings and the print’s own lettering. Use Instrument Sans for controls, instructions and small metadata; Instrument Serif supplies intimate captions and dedications.",
        "section": "typography"
      },
      {
        "name": "The Shared Guides Rule",
        "body": "Align the preview, fields, choices and action stack to deliberate column edges. Contain enlarged-proof scrolling within its own focusable region.",
        "section": "layout"
      },
      {
        "name": "The Artwork Depth Rule",
        "body": "Concentrate diffuse depth on the physical artwork, its frame and its native photograph and flag mounts. Forms, summaries and status surfaces stay flat and legible.",
        "section": "elevation"
      },
      {
        "name": "The Complete Proof Rule",
        "body": "Keep the complete print visible at composition scale, and offer a separate enlarged inspection region when personalization becomes too small to read.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the approved print proportions, actual country artwork, true geography, recipient dedication and complete flag faces.",
      "Do align headings, art stages, fields, choice groups and action stacks to shared gutters and deliberate column guides.",
      "Do keep focus, status, validation and recovery messages adjacent to the affected controls, with the current names, dedication and selected photographs preserved.",
      "Do use the same visual language for an individual atlas, a friend’s gift or an atlas for any two people.",
      "Do retain the visible local-photo, frame-visualization and personal-digital-proof disclosures."
    ],
    "donts": [
      "Don’t replace illustrated artwork with generic map decoration or adopt the separate support identity’s palette and type.",
      "Don’t crop a complete proof to fit its preview stage or turn enlarged inspection into page-wide horizontal scrolling.",
      "Don’t turn flat form, summary or recovery surfaces into elevated cards, pills or badge clusters.",
      "Don’t replace authored SVG disclosure marks with font glyphs.",
      "Don’t use tiny print lettering as the only readable confirmation of edited names or shared counts."
    ]
  }
}

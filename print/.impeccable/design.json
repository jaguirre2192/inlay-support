      "css": "@font-face{font-family:Sans;src:url('/print/assets/fonts/InstrumentSans-Regular.ttf')}.ds-button{box-sizing:border-box;font:400 14px/1.4 Sans,system-ui,sans-serif;display:inline-flex;min-height:49px;align-items:center;justify-content:center;gap:12px;border:1px solid var(--ink,#22382e);border-radius:2px;padding:12px 22px;cursor:pointer;text-decoration:none;background:var(--ink,#22382e);color:var(--paper,#f5f0e4)}.ds-button:hover{background:#3c5140;color:var(--paper,#f5f0e4)}.ds-button:focus-visible{outline:2px solid var(--focus,#7d542d);outline-offset:5px;}.ds-button:disabled{cursor:wait;opacity:.55}@media(prefers-reduced-motion:no-preference){.ds-button{transition:background-color .18s,color .18s}}"

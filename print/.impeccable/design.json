      "css": "@font-face{font-family:Sans;src:url('/print/assets/fonts/InstrumentSans-Regular.ttf')}.ds-nav{box-sizing:border-box;height:84px;border-bottom:1px solid var(--line,#cdcdbb);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 var(--gutter,clamp(24px,5vw,80px));gap:16px;color:var(--ink,#22382e);font-family:Sans,system-ui,sans-serif}.ds-back{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:13px;color:inherit}.ds-back-icon{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.5;flex:none}.ds-wordmark{font:14px Sans,sans-serif;letter-spacing:.26em;text-decoration:none;color:inherit}.ds-nav-action{box-sizing:border-box;justify-self:end;min-height:44px;border:0;background:transparent;color:inherit;text-decoration:underline;text-underline-offset:4px;padding:10px 0;font:400 14px/1.55 Sans,system-ui,sans-serif;cursor:pointer}.ds-back:hover,.ds-wordmark:hover,.ds-nav-action:hover{color:#7d542d}.ds-back:focus-visible,.ds-wordmark:focus-visible,.ds-nav-action:focus-visible{outline:2px solid var(--focus,#7d542d);outline-offset:5px;}@media(max-width:850px){.ds-nav{height:72px}}@media(max-width:480px){.ds-nav{padding:0 24px;gap:10px}.ds-back-text{display:none}.ds-nav-action{font-size:12px}.ds-wordmark{font-size:13px}}@media(prefers-reduced-motion:no-preference){.ds-back,.ds-wordmark,.ds-nav-action{transition:background-color .18s,color .18s}}"

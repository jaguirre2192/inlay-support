      "css": "@font-face{font-family:Sans;src:url('/print/assets/fonts/InstrumentSans-Regular.ttf')}.ds-file-label{display:block;margin-bottom:8px;color:var(--ink,#22382e);font:400 14px/1.55 Sans,system-ui,sans-serif}.ds-file-input{box-sizing:border-box;display:block;width:100%;max-width:100%;min-height:48px;line-height:1.5;color:var(--ink,#22382e);font-family:Sans,system-ui,sans-serif;font-size:13px}.ds-file-input::file-selector-button{box-sizing:border-box;min-height:44px;border:1px solid var(--ink,#22382e);border-radius:2px;background:var(--field,#faf7ed);color:var(--ink,#22382e);padding:10px 14px;margin-right:12px;font:inherit;cursor:pointer}.ds-file-input::file-selector-button:hover{background:var(--selected,#e5e9d8)}.ds-file-input:focus-visible{outline:2px solid var(--focus,#7d542d);outline-offset:5px;}"

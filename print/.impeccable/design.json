      "html": "<fieldset class=\"ds-choice-field\"><legend class=\"ds-choice-legend\">Edition</legend><div class=\"ds-choices\"><label class=\"ds-choice\"><input class=\"ds-choice-input\" type=\"radio\" name=\"ds-edition\" checked><span class=\"ds-choice-face\">Your World</span></label><label class=\"ds-choice\"><input class=\"ds-choice-input\" type=\"radio\" name=\"ds-edition\"><span class=\"ds-choice-face\">Country</span></label><label class=\"ds-choice\"><input class=\"ds-choice-input\" type=\"radio\" name=\"ds-edition\"><span class=\"ds-choice-face\">Memory</span></label></div></fieldset>",
